{
  "name": "wexample/symfony-file",
  "description": "File management helpers for Symfony",
  "type": "library",
  "license": "MIT",
  "version": "6.0.3",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyFile\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wexample\\SymfonyFile\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "wexample/php-file": ">=2.1.0",
    "wexample/symfony-helpers": ">=19.3.0",
    "wexample/symfony-api": ">=21.0.0",
    "wexample/php-pseudocode": ">=3.1.0",
    "wexample/symfony-pseudocode": ">=4.0.2",
    "symfony/uid": ">=6.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^13"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}